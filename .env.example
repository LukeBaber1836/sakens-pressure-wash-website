# Copy this file to .env.local and fill in the values. .env.local is git-ignored; this file is not,
# so never put real keys here.

# Resend API key (sending access is enough): https://resend.com/api-keys
RESEND_API_KEY=

# Where quote requests are delivered. Comma-separate for more than one.
QUOTE_TO_EMAIL=you@example.com

# Must be on a domain verified in Resend, e.g. "Saken's Pressure Washing <quotes@yourdomain.com>".
# Until one is, use onboarding@resend.dev, which can only deliver to the email on your Resend account.
QUOTE_FROM_EMAIL=Saken's Pressure Washing <quotes@sakenpressurewash.com>

# PostHog browser analytics configuration
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
